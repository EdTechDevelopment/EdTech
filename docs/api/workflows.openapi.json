{
  "openapi": "3.1.0",
  "info": {
    "title": "Workflows HTTP API",
    "version": "1.0.0",
    "description": "Реализованный MVP этапов 6–7. Регистрация создаёт аккаунт и профиль на каждую роль атомарно и отвечает 202 без токенов. Добавление второй роли требует текущий ACTIVE аккаунт и отвечает 201 MeResponse; после него клиент обновляет JWT через refresh. GET /me читает только principal владельца. Pending контактного email существует только в аккаунте. Unlink и карточка со статистикой отложены до Scheduling."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "operationId": "registerAccountWithProfiles",
        "summary": "Зарегистрировать аккаунт с обязательными профилями",
        "security": [],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID одной операции. Повтор с тем же ключом и эквивалентными данными возвращает сохранённый результат. Ключ уникален для всех операций Workflows; другая операция, аккаунт/email или payload дают 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationPendingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос, роль/профиль, предмет или ключ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт ключа, роли или email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Тело больше workflows.http.max-request-bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка или роль без профиля",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Хранилище временно недоступно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getOwnAccountAndProfiles",
        "summary": "Свой аккаунт и профили",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Требуется Bearer JWT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Аккаунт недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка или роль без профиля",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Хранилище временно недоступно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me/roles/teacher": {
      "post": {
        "operationId": "addTeacherRoleWithProfile",
        "summary": "Добавить роль преподавателя с профилем",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID одной операции. Повтор с тем же ключом и эквивалентными данными возвращает сохранённый результат. Ключ уникален для всех операций Workflows; другая операция, аккаунт/email или payload дают 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./tutoring.openapi.json#/components/schemas/UpdateTeacherProfile"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос, роль/профиль, предмет или ключ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Требуется Bearer JWT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Аккаунт не ACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Аккаунт недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт ключа, роли или email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Тело больше workflows.http.max-request-bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка или роль без профиля",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Хранилище временно недоступно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me/roles/student": {
      "post": {
        "operationId": "addStudentRoleWithProfile",
        "summary": "Добавить роль ученика с профилем",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID одной операции. Повтор с тем же ключом и эквивалентными данными возвращает сохранённый результат. Ключ уникален для всех операций Workflows; другая операция, аккаунт/email или payload дают 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./tutoring.openapi.json#/components/schemas/UpdateStudentProfile"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос, роль/профиль, предмет или ключ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Требуется Bearer JWT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Аккаунт не ACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Аккаунт недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт ключа, роли или email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Тело больше workflows.http.max-request-bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка или роль без профиля",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Хранилище временно недоступно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      }
    },
    "schemas": {
      "RegistrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "pattern": "^[!-~]+$"
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "description": "Дата рождения аккаунта, не позже текущей даты UTC."
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "enum": [
                "TEACHER",
                "STUDENT"
              ]
            }
          },
          "teacherProfile": {
            "anyOf": [
              {
                "$ref": "./tutoring.openapi.json#/components/schemas/UpdateTeacherProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "studentProfile": {
            "anyOf": [
              {
                "$ref": "./tutoring.openapi.json#/components/schemas/UpdateStudentProfile"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName",
          "birthDate",
          "roles"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "roles": {
                  "contains": {
                    "const": "TEACHER"
                  }
                }
              }
            },
            "then": {
              "required": [
                "teacherProfile"
              ],
              "properties": {
                "teacherProfile": {
                  "$ref": "./tutoring.openapi.json#/components/schemas/UpdateTeacherProfile"
                }
              }
            },
            "else": {
              "properties": {
                "teacherProfile": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "roles": {
                  "contains": {
                    "const": "STUDENT"
                  }
                }
              }
            },
            "then": {
              "required": [
                "studentProfile"
              ],
              "properties": {
                "studentProfile": {
                  "$ref": "./tutoring.openapi.json#/components/schemas/UpdateStudentProfile"
                }
              }
            },
            "else": {
              "properties": {
                "studentProfile": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "VerificationPendingResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "verificationExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "email",
          "verificationExpiresAt"
        ]
      },
      "OwnAccount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "pendingEmail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "TEACHER",
                "STUDENT"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_EMAIL_VERIFICATION",
              "ACTIVE",
              "SUSPENDED",
              "DEACTIVATED"
            ]
          },
          "emailVerifiedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "pendingEmail",
          "firstName",
          "lastName",
          "birthDate",
          "roles",
          "status",
          "emailVerifiedAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "MeResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user": {
            "$ref": "#/components/schemas/OwnAccount"
          },
          "teacherProfile": {
            "anyOf": [
              {
                "$ref": "./tutoring.openapi.json#/components/schemas/TeacherProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "studentProfile": {
            "anyOf": [
              {
                "$ref": "./tutoring.openapi.json#/components/schemas/StudentProfile"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "user",
          "teacherProfile",
          "studentProfile"
        ]
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "code",
                "message"
              ]
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "fieldErrors",
          "requestId"
        ]
      }
    }
  }
}
